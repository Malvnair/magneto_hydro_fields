Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"EXTRA", " ", "PLOT"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tubeFactor", "=", "5"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Larger", "=", 
     RowBox[{"thinner", " ", "tubes"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"arrowFactor", "=", "3"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"Larger", "=", 
     RowBox[{"smaller", " ", "arrows"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"numStreams", "=", "120"}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Number", " ", "of", " ", "streamlines"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Small", " ", "padding", " ", "to", " ", "avoid", " ", "boundary", " ", 
     "interpolation", " ", "issues"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"eps", "=", 
     RowBox[{"0.01", "*", 
      RowBox[{"(", 
       RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], ";"}], "\[IndentingNewLine]",
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "magnetic", " ", "field", " ", "streamlines"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"streamPlotB", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StreamPlot3D", "[", 
        RowBox[{
         RowBox[{"B", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"xMin", "+", "eps"}], ",", 
           RowBox[{"xMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{"yMin", "+", "eps"}], ",", 
           RowBox[{"yMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"{", 
          RowBox[{"z", ",", 
           RowBox[{"zMin", "+", "eps"}], ",", 
           RowBox[{"zMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StreamPoints", "->", "numStreams"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"StreamMarkers", "->", "\"\<Arrow3D\>\""}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<X (AU)\>\"", ",", "\"\<Y (AU)\>\"", 
            ",", "\"\<Z (AU)\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotLabel", "->", "\"\<MHD Magnetic Field\>\""}], ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"Ticks", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FindDivisions", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "5"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"FindDivisions", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"yMin", ",", "yMax"}], "}"}], ",", "5"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"FindDivisions", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"z0", ",", "zMax"}], "}"}], ",", "5"}], "]"}]}], 
           "}"}]}]}], "]"}], "/.", " ", 
       RowBox[{"x_Tube", ":>", 
        RowBox[{"Tube", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "/", "tubeFactor"}]}], "]"}]}]}], 
      "/.", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Arrowheads", "[", 
        RowBox[{"x_", ",", "y__"}], "]"}], ":>", 
       RowBox[{"Arrowheads", "[", 
        RowBox[{
         RowBox[{"x", "/", "arrowFactor"}], ",", "y"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"streamPlotB", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"yMin", ",", "yMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"zMin", ",", "zMax"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRangePadding", "->", "0"}]}], "]"}]}]}]], "Input",
