Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tubeFactor", "=", "5"}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"Larger", "=", 
    RowBox[{"thinner", " ", "tubes"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"arrowFactor", "=", "3"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"Larger", "=", 
    RowBox[{"smaller", " ", "arrows"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numStreams", "=", "120"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"Number", " ", "oof", " ", "streamlines"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"FIX", ":", " ", 
    RowBox[{
    "Small", " ", "padding", " ", "to", " ", "avoid", " ", "boundary", " ", 
     "interpolation", " ", "issues"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eps", "=", 
    RowBox[{"0.01", "*", 
     RowBox[{"(", 
      RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Only", " ", "take", " ", "z"}], ">", "0"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"z0", "=", "0"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "streamlines"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"streamPlot0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"StreamPlot3D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"xMin", "+", "eps"}], ",", 
         RowBox[{"xMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"yMin", "+", "eps"}], ",", 
         RowBox[{"yMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"zMin", "+", "eps"}], ",", "z0"}], "]"}], ",", 
         RowBox[{"zMax", "-", "eps"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"StreamPoints", "->", "numStreams"}], ",", 
       RowBox[{"StreamMarkers", "->", "\"\<Arrow3D\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<X (AU)\>\"", ",", "\"\<Y (AU)\>\"", 
          ",", "\"\<Z (AU)\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", "\"\<MHD Velocity Field\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Change", " ", "ratio", " ", "to", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}], " ", "if", " ", "want", " ",
          "cubic", " ", "represenation", " ", 
         RowBox[{"(", "scaled", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FindDivisions", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xMin", ",", "xMax"}], "}"}], ",", "5"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FindDivisions", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"yMin", ",", "yMax"}], "}"}], ",", "5"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FindDivisions", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"z0", ",", "zMax"}], "}"}], ",", "5"}], "]"}]}], 
         "}"}]}]}], "]"}], "/.", " ", 
     RowBox[{"x_Tube", ":>", 
      RowBox[{"Tube", "[", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/", "tubeFactor"}]}], "]"}]}]}], "/.",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Arrowheads", "[", 
      RowBox[{"x_", ",", "y__"}], "]"}], ":>", 
     RowBox[{"Arrowheads", "[", 
      RowBox[{
       RowBox[{"x", "/", "arrowFactor"}], ",", "y"}], "]"}]}]}]}], 
  ";"}]}], "Input",
